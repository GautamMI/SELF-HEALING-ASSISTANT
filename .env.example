# ===========================================================================
# Repo-level configuration.
#
#   cp .env.example .env
#   cp .env.example apps/self-healing-agent/.env      # agent reads either file
#
# Secrets belong here and NOWHERE else. `.env` is git-ignored.
# ===========================================================================

# --- OpenAI (required) ----------------------------------------------------
# https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-key
OPENAI_API_KEY=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
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_OUTPUT_TOKENS=6000
OPENAI_TIMEOUT_MS=90000
OPENAI_MAX_RETRIES=3
MIN_CONFIDENCE=0.55

# --- GitHub (required unless DRY_RUN=true) --------------------------------
# Fine-grained PAT with: Contents = read/write, Pull requests = read/write
GITHUB_TOKEN=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
GITHUB_OWNER=GautamMI
GITHUB_REPO=https://github.com/GautamMI/SELF-HEALING-ASSISTANT.git
GIT_BASE_BRANCH=main
GIT_BRANCH_PREFIX=autofix
GIT_AUTHOR_NAME=self-healing-bot
GIT_AUTHOR_EMAIL=self-healing-bot@users.noreply.github.com
GIT_PUSH_ENABLED=true
PR_LABELS=self-healing,automated-fix
PR_DRAFT_ON_VALIDATION_FAILURE=true

# --- Agent behaviour ------------------------------------------------------
WATCH_LOG_FILE=apps/buggy-backend/logs/error.log
PROCESS_EXISTING_ON_START=false
WATCH_USE_POLLING=false
REPO_ROOT=.
TARGET_APP_DIR=apps/buggy-backend
ALLOWED_PATH_PREFIXES=apps/buggy-backend/src
MAX_FILES_PER_FIX=3
DRY_RUN=false
DEDUP_TTL_MS=900000
MAX_HEALS_PER_HOUR=5
VALIDATE_TYPECHECK=true
VALIDATE_TESTS=true
VALIDATION_TIMEOUT_MS=180000
LOG_LEVEL=info
LOG_PRETTY=true

# --- Application 1 --------------------------------------------------------
PORT=4000
NODE_ENV=development
