{
  "name": "@self-healing/agent",
  "version": "1.0.0",
  "private": true,
  "description": "Application 2 - watches error logs, asks OpenAI for a fix, patches the code and raises a GitHub PR",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --clear src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "heal:once": "ts-node-dev --transpile-only src/index.ts --once",
    "test": "jest --runInBand --passWithNoTests"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "diff": "^5.2.0",
    "dotenv": "^16.4.5",
    "openai": "^4.67.3",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "simple-git": "^3.27.0",
    "zod": "^3.23.8",
    "@octokit/rest": "^20.1.1"
  },
  "devDependencies": {
    "@types/diff": "^5.2.2",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  }
}
