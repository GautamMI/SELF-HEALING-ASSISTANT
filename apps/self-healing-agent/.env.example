# ---------------------------------------------------------------------------
# Application 2 - self-healing agent
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

# --- What to watch -------------------------------------------------------
# Absolute path, or relative to the monorepo root.
WATCH_LOG_FILE=apps/buggy-backend/logs/error.log
# Replay lines that already exist in the file on startup (useful for demos).
PROCESS_EXISTING_ON_START=false
# Enable when the log lives on a Docker bind mount / network share.
WATCH_USE_POLLING=false
WATCH_POLL_INTERVAL_MS=500

# --- Repository under repair --------------------------------------------
REPO_ROOT=.
TARGET_APP_DIR=apps/buggy-backend
# Only files under these prefixes may ever be patched (comma separated).
ALLOWED_PATH_PREFIXES=apps/buggy-backend/src
MAX_FILES_PER_FIX=3

# --- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=6000
OPENAI_TEMPERATURE=0.1
OPENAI_TIMEOUT_MS=90000
OPENAI_MAX_RETRIES=3
# Fixes below this confidence are still opened, but as draft PRs.
MIN_CONFIDENCE=0.55

# --- Git / GitHub ---------------------------------------------------------
GITHUB_TOKEN=ghp_replace_me
GITHUB_OWNER=your-github-username
GITHUB_REPO=self-healing-assistant
GIT_BASE_BRANCH=main
GIT_BRANCH_PREFIX=autofix
GIT_AUTHOR_NAME=self-healing-bot
GIT_AUTHOR_EMAIL=self-healing-bot@users.noreply.github.com
GIT_PUSH_ENABLED=true
PR_LABELS=self-healing,automated-fix
PR_DRAFT_ON_VALIDATION_FAILURE=true

# --- Safety rails ---------------------------------------------------------
# true  -> analyse + write a patch locally, but never commit/push/open a PR
DRY_RUN=false
DEDUP_TTL_MS=900000
DEDUP_MAX_ENTRIES=500
MAX_HEALS_PER_HOUR=5
VALIDATE_TYPECHECK=true
VALIDATE_TESTS=true
VALIDATION_TIMEOUT_MS=180000
