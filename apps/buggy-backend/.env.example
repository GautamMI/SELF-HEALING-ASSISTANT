# ---------------------------------------------------------------------------
# Application 1 - buggy-backend runtime configuration
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
SERVICE_NAME=buggy-backend

# Logging
LOG_LEVEL=debug
LOG_DIR=logs
LOG_FILE=error.log
LOG_PRETTY=true

# Downstream "pricing" dependency. Points at this app's own stub route by
# default so the invalid-API-response bug is reproducible with zero network.
PRICING_API_URL=http://localhost:4000/internal/pricing-feed
PRICING_API_TIMEOUT_MS=4000
